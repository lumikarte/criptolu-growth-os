# Copiá a .env y completá. El .env real está gitignored.

# Transcripción (FP-MVP-03) y detección con Groq (PP-MVP-01). Una sola key.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Detección con Claude (PP-MVP-01, opcional). Solo si usás engine=claude.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Pipeline asíncrono (CRI-603). Redis/Valkey para la cola de jobs.
REDIS_URL=redis://localhost:6379/0
# JOBS_EAGER=1   # corre el pipeline inline (sin Redis ni worker); para dev/test

# Diarización (W-02, CRI-561). Engine 'assemblyai' (cloud, default). Sin GPU ni token HF.
# ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxx
# Engine 'pyannote' (local, opcional): requiere torch + este token y aceptar el modelo gated.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Distribución (W-05, CRI-564). Postiz self-host (Docker) + OAuth propio por red.
# POSTIZ_BASE_URL=http://localhost:4007/public/v1
# POSTIZ_API_KEY=xxxxxxxxxxxxxxxxxxxx
# DISTRIBUTION_ALLOW_AUTOPOST=1   # fase 2: habilita publicar/programar (default: solo borrador)

# Auto-crop 9:16 face-tracked (CRI-128). Apagado por default. Requiere opencv-python-headless
# y el modelo YuNet en app/models/ (ver app/models/README.md). Sin eso → crop central de siempre.
# AUTOCROP_ENABLED=1
# En prod, Postiz identifica el canal por su id propio (no por el nombre de la red). Ese id
# se completa por red (uno por app OAuth conectada); sin esto no publica de verdad. Como no
# hay una var por red en el .env, se setea en app/config.POSTIZ_INTEGRATIONS = {"facebook": "..."}.
