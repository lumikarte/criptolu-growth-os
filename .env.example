# Copiá a .env y completá. El .env real está gitignored.

# Transcripción (FP-MVP-03) y detección con Groq (PP-MVP-01). Una sola key.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Detección con Claude (PP-MVP-01, opcional). Solo si usás engine=claude.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Pipeline asíncrono (CRI-603). Redis/Valkey para la cola de jobs.
REDIS_URL=redis://localhost:6379/0
# JOBS_EAGER=1   # corre el pipeline inline (sin Redis ni worker); para dev/test

# Diarización (W-02, CRI-561). Engine 'assemblyai' (cloud, default). Sin GPU ni token HF.
# ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxx
# Engine 'pyannote' (local, opcional): requiere torch + este token y aceptar el modelo gated.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
